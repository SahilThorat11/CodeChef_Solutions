import java.util.*;
import java.lang.*;
import java.io.*;

class Ageing
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sobj = new Scanner(System.in);
		
		int T = sobj.nextInt();
		
		while(T > 0)
		{
		    int X = sobj.nextInt();
		    
		    System.out.println(X - 10);
		    
		    T--;
		}
	}
}
